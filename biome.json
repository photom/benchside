{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!site", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/mail/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Packages must not touch the DOM",
                  "document": "Packages must not touch the DOM",
                  "fetch": "Use the injected Resolver"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/dns/src/**",
        "!packages/dns/src/doh.ts",
        "!packages/dns/src/doh.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Packages must not touch the DOM",
                  "document": "Packages must not touch the DOM",
                  "fetch": "Only doh.ts makes requests (0014)",
                  "XMLHttpRequest": "Only doh.ts makes requests (0014)",
                  "WebSocket": "Only doh.ts makes requests (0014)",
                  "EventSource": "Only doh.ts makes requests (0014)",
                  "navigator": "Only doh.ts makes requests (0014)",
                  "globalThis": "Only doh.ts makes requests (0014)",
                  "self": "Only doh.ts makes requests (0014)"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**",
        "!packages/dns/**",
        "apps/*/src/**",
        "!apps/*/src/worker/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@benchside/dns/doh": "Only app workers import the DoH transport (0014)"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/zip/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Packages must not touch the DOM",
                  "document": "Packages must not touch the DOM",
                  "fetch": "The ZIP analyzer makes no network requests (REQ-ZIP-001)",
                  "XMLHttpRequest": "The ZIP analyzer makes no network requests (REQ-ZIP-001)",
                  "WebSocket": "The ZIP analyzer makes no network requests (REQ-ZIP-001)"
                }
              }
            }
          }
        }
      }
    }
  ]
}
