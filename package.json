{
  "name": "benchside",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/mail/tsconfig.worker.json && tsc --noEmit -p apps/zip/tsconfig.worker.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project dom",
    "test:browser": "vitest run --project browser",
    "test:build": "vitest run --project build",
    "build": "npm run build --workspaces --if-present && node scripts/collect-pages.mjs",
    "docs:check": "node scripts/check-mermaid.ts",
    "check": "npm run typecheck && npm run lint && npm run docs:check && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
